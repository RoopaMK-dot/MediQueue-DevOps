[Unit]
Description=MediQueue FastAPI service
After=network.target

[Service]
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_directory }}
Environment="PATH={{ app_directory }}/venv/bin"
ExecStart={{ app_directory }}/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port {{ app_port }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
